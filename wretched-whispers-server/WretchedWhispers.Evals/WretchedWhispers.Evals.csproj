    <ProjectReference Include="..\WretchedWhispers.Core\WretchedWhispers.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\WretchedWhispers.Api\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\WretchedWhispers.Api\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

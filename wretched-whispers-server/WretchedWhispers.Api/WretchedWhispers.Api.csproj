<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\WretchedWhispers.Engine\WretchedWhispers.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.13.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>WretchedWhispers.Console-dev</UserSecretsId>
    <DeploymentProfile Condition="'$(DeploymentProfile)'==''">Server</DeploymentProfile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DeploymentProfile)'=='Server'">
    <DefineConstants>$(DefineConstants);DEPLOYMENT_SERVER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DeploymentProfile)'=='StandaloneContainer'">
    <DefineConstants>$(DefineConstants);DEPLOYMENT_STANDALONE_CONTAINER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DeploymentProfile)'=='Desktop'">
    <DefineConstants>$(DefineConstants);DEPLOYMENT_DESKTOP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Desktop\**" Condition="'$(DeploymentProfile)'!='Desktop'" />
  </ItemGroup>
  <ItemGroup Condition="'$(DeploymentProfile)'=='Desktop'">
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <Target Name="ValidateDeploymentProfile" BeforeTargets="BeforeBuild"
          Condition="'$(DeploymentProfile)'!='Server' and '$(DeploymentProfile)'!='StandaloneContainer' and '$(DeploymentProfile)'!='Desktop'">
    <Error Text="Invalid DeploymentProfile '$(DeploymentProfile)'. Expected Server, StandaloneContainer, or Desktop." />
  </Target>

</Project>

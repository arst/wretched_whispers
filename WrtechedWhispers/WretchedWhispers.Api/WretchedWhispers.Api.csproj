<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="..\WretchedWhispers.Engine\WretchedWhispers.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.13.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>WretchedWhispers.Console-dev</UserSecretsId>
  </PropertyGroup>

  <!-- Desktop build: -p:DesktopBuild=true switches on the Photino native shell + the
       #if DESKTOP runtime branch. Off (the default) → hosted web build, never ships Photino. -->
  <PropertyGroup Condition="'$(DesktopBuild)'=='true'">
    <DefineConstants>$(DefineConstants);DESKTOP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Desktop\**" Condition="'$(DesktopBuild)'!='true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(DesktopBuild)'=='true'">
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

</Project>
